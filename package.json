  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
